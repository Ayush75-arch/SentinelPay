{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/model/:path*", "destination": "/api/index.py" },
    { "source": "/auth/:path*", "destination": "/api/index.py" },
    { "source": "/transactions/:path*", "destination": "/api/index.py" },
    { "source": "/users/:path*", "destination": "/api/index.py" },
    { "source": "/demo/:path*", "destination": "/api/index.py" },
    { "source": "/travel-mode/:path*", "destination": "/api/index.py" },
    { "source": "/webauthn/:path*", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
